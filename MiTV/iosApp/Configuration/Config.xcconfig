PODS_ROOT=$(SRCROOT)/Pods
PODS_PODFILE_DIR_PATH=$(SRCROOT)
#include? "../Pods/Target Support Files/Pods-iosApp/Pods-iosApp.release.xcconfig"
#include? "../Pods/Target Support Files/Pods-iosApp/Pods-iosApp.debug.xcconfig"

TEAM_ID=
PRODUCT_NAME=XaviTV
PRODUCT_BUNDLE_IDENTIFIER=com.minuevaapp.tv.ios
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.1.0
IPHONEOS_DEPLOYMENT_TARGET=15.0
TARGETED_DEVICE_FAMILY=1,2
FRAMEWORK_SEARCH_PATHS=$(inherited) "$(SRCROOT)/Frameworks" "$(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)" "$(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/iphoneos" "$(SRCROOT)/../shared/build/bin/iosArm64/releaseFramework"
OTHER_LDFLAGS=$(inherited) -framework ComposeApp -framework AVFAudio -framework AVFoundation -framework AVKit -framework CoreMedia -framework UIKit -framework Foundation
LD_RUNPATH_SEARCH_PATHS=$(inherited) @executable_path/Frameworks
